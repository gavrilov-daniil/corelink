[Unit]
Description=VPN node-agent (control-plane pull daemon)
Documentation=https://vpn-platform/apps/node-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/node-agent --config /etc/node-agent/config.json
Restart=always
RestartSec=5

# --- Identity ---------------------------------------------------------------
# Static user is preferred over DynamicUser here: the agent must call
# `systemctl restart <xray-unit>`, which needs a stable principal for the polkit
# rule below. (DynamicUser=yes would work only if the agent ran as root.)
User=node-agent
Group=node-agent
# Read access to the system journal: when Xray fails to start, the agent reports
# the reason from `journalctl -u xray` (e.g. "bind: address already in use").
# Without the group it only gets systemd's exit code.
SupplementaryGroups=systemd-journal

# StateDirectory creates and chowns /var/lib/node-agent for us (applied-state,
# stats buffer, reality keypair live here).
StateDirectory=node-agent
StateDirectoryMode=0750

# --- Hardening --------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The agent itself only dials OUT and binds nothing; the bounding set is a
# ceiling, not a grant. Kept minimal per hardening requirement.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Writable paths: config file directory (agent writes Xray config there) plus the
# managed state dir. Everything else is read-only via ProtectSystem=strict.
ReadWritePaths=/etc/xray

# NOTE: with User=node-agent + NoNewPrivileges, `systemctl restart xray.service`
# is denied by default. Grant it narrowly with a polkit rule, e.g.
# /etc/polkit-1/rules.d/50-node-agent-xray.rules:
#   polkit.addRule(function(action, subject) {
#     if (action.id == "org.freedesktop.systemd1.manage-units" &&
#         action.lookup("unit") == "xray.service" &&
#         subject.user == "node-agent") { return polkit.Result.YES; }
#   });

[Install]
WantedBy=multi-user.target
