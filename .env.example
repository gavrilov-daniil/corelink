# Полный список переменных, которые читает код. Ничего сверх этого списка не читается.
# Источники: apps/core/src/config.ts, apps/bot/src/config.ts, packages/db/src/client.ts.
# Конфиг node-agent живёт НА НОДЕ (JSON + NODE_AGENT_*), сюда не входит — см. apps/node-agent/README.md.

# --- core ---
INSTANCE_TYPE=api                 # api | worker. worker = тот же контекст без HTTP, требует REDIS_URL
CORE_PORT=3100
# Внешний URL API. Из него строятся callback_url платёжных вебхуков — значение
# напрямую определяет, куда провайдер пришлёт подтверждение оплаты.
PUBLIC_API_URL=http://localhost:3100

# --- data ---
# ОБЯЗАТЕЛЬНО: без DATABASE_URL createDb бросает исключение на старте.
DATABASE_URL=postgres://vpn:vpn@localhost:5442/vpn_platform
# Пусто → degraded-режим: очередей и расписания нет, джобы гоняются вручную
# из админки (POST /api/admin/jobs/:name/run). INSTANCE_TYPE=worker без Redis завершается.
REDIS_URL=redis://localhost:6392

# --- tenancy (single-org deploy) ---
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# --- secrets ---
# ОБЯЗАТЕЛЬНО: core не стартует, если пусто ИЛИ короче 16 символов.
# Ключ шифрования кредов мерчантов (AES-256-GCM). В БД креды лежат только зашифрованными.
# Генерить случайно, в проде — из vault. Смена ключа делает уже сохранённые креды
# мерчантов нечитаемыми: процедуры перешифрования нет, ключи придётся вводить заново.
SECRETS_MASTER_KEY=

# --- subscription delivery ---
# ДОЛЖЕН совпадать с тем, что уже сохранён у мигрированных клиентов (migration.md P0-2)
SUB_PUBLIC_HOST=panel.gavy.shop
SUB_PROFILE_UPDATE_INTERVAL=12     # часов, заголовок profile-update-interval
# Заголовок profile-title. Кириллица уедет в заголовок как base64:<...> (так же делает
# действующая панель). Значение видно клиенту как имя подписки.
SUB_PROFILE_TITLE=VPN
SUB_SUPPORT_URL=                   # пусто → заголовок support-url не отдаётся
SUB_ANNOUNCE=                      # пусто → заголовок announce не отдаётся

# Лимиты выдачи (скользящее окно). Тело подписки — plain-text ключи нод и vless_uuid,
# расшаренная в чат ссылка не должна дёргаться сотнями клиентов. 0 = правило выключено.
# Хранилище: Redis при заданном REDIS_URL, иначе память процесса (барьер на инстанс).
# Клиент опрашивает подписку раз в несколько часов, так что 30 запросов за 10 минут —
# это уже явно не он. Лимит по IP заметно шире: за общим NAT сидит много честных клиентов.
SUB_RATE_LIMIT_PER_SUB=30
SUB_RATE_LIMIT_PER_IP=300
SUB_RATE_LIMIT_WINDOW_SEC=600
# true (по умолчанию) — адрес клиента берётся из ПРАВОГО (ближайшего к нам) хопа
# x-forwarded-for: его дописал наш собственный прокси, всё левее прислал клиент.
# ЗА РЕВЕРС-ПРОКСИ ЭТО ОБЯЗАТЕЛЬНО: иначе все клиенты приходят с одного socket-адреса
# и лимит по IP режет всю базу разом. Если core смотрит в интернет напрямую — false,
# иначе заголовок подделывается и лимит по IP обходится одной строкой.
# Инвариант деплоя: перед core стоит РОВНО ОДИН доверенный прокси. Второй сдвинет
# нужный хоп, и лимит начнёт считать по адресу внутреннего прокси, склеив всех клиентов.
SUB_RATE_LIMIT_TRUST_PROXY=true

# Окно «живого» устройства для hwid device-limit. Устройство, не приходившее дольше,
# слот не занимает: иначе юзер, сменивший три телефона, упрётся в лимит при одном живом.
SUB_HWID_ACTIVE_DAYS=30

# --- лимиты непубличных разделов (RateLimitGuard) ---
# Считаются по IP (источник адреса — тот же SUB_RATE_LIMIT_TRUST_PROXY), 0 = правило выключено.
# Хранилище общее с выдачей подписки: Redis при заданном REDIS_URL, иначе память процесса.

# Вход в админку. Жёстко и в два ключа: по IP — против перебора пароля с одной машины,
# по email — против того же перебора, размазанного по адресам. Оператор входит раз в неделю,
# 10 попыток за 15 минут ему хватит с запасом.
ADMIN_LOGIN_RATE_LIMIT_PER_IP=10
ADMIN_LOGIN_RATE_LIMIT_PER_EMAIL=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SEC=900

# Остальной /api/admin/*. Мягко: это рабочий инструмент, и лимит тут — потолок от
# перебора ADMIN_TOKEN, а не регулятор темпа живой работы.
ADMIN_RATE_LIMIT_PER_IP=300
ADMIN_RATE_LIMIT_WINDOW_SEC=60

# Вебхуки провайдеров. С запасом: провайдер, у которого копилась очередь, догоняет её пачкой,
# и срезать такую пачку — значит потерять подтверждения оплат.
WEBHOOK_RATE_LIMIT_PER_IP=600
WEBHOOK_RATE_LIMIT_WINDOW_SEC=60

# /internal/* — бот, воркеры и node-agent'ы. Ноды ходят с разных адресов, но бот с одного,
# поэтому окно широкое.
INTERNAL_RATE_LIMIT_PER_IP=1200
INTERNAL_RATE_LIMIT_WINDOW_SEC=60

# --- node-agent ---
# ПЕРЕХОДНЫЙ общий секрет всего парка нод (заголовок x-agent-token).
# Штатный путь — энроллмент: POST /api/admin/nodes/:id/enrollment выдаёт одноразовый
# bootstrap-токен, агент меняет его на СВОЙ per-node токен (см. docs/security.md).
# У ноды, прошедшей энроллмент, общий токен уже НЕ принимается.
# Оставлять заполненным только пока в парке есть неэнролленные ноды: общий токен даёт
# доступ к desired-state ЛЮБОЙ ноды, поэтому изъятие одной вскрывает весь парк.
# core пишет предупреждение при старте, если переменная задана.
AGENT_TOKEN=

# Срок жизни невостребованного bootstrap-токена ноды, часы. Просроченный токен
# энроллмент не принимает — выпускается новый из админки. 0 = без срока (токен живёт
# до перевыпуска; так же выглядят токены, выпущенные до появления колонки).
NODE_BOOTSTRAP_TTL_HOURS=24

# Приватный RSA-ключ (PEM) подписи desired-state. Пусто → desired-state уходит голым
# JSON (переходный режим): агент принимает такой ответ, только если у него самого не
# задан cp_public_key_path.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out cp-signing.key
#   openssl rsa -in cp-signing.key -pubout -out cp-signing.pub   # .pub → на ноды
# В .env кладётся одной строкой с \n вместо переносов; приватник — в vault, не в репо.
DESIRED_STATE_SIGNING_KEY=

# --- боты (два: клиентский и админский) ---
# Поднимать ли контейнер бота на боевом стенде. Пусто/false — сервис не создаётся
# вовсе (профиль compose), и стенд живёт без клиентского бота: это рабочий режим,
# пока бот не заведён. true с пустым BOT_TOKEN — не режим, а опечатка: релиз падает
# до старта, а не оставляет контейнер в вечном крэш-цикле. Проверяется в deploy/verify.sh.
BOT_ENABLED=false
# ОБЯЗАТЕЛЬНО при BOT_ENABLED=true: без BOT_TOKEN процесс бота не стартует.
BOT_TOKEN=
BOT_PORT=3300
# Задан → webhook; пусто → long polling (локальная разработка).
BOT_WEBHOOK_URL=
# ОБЯЗАТЕЛЬНО, если задан BOT_WEBHOOK_URL: иначе бот не стартует.
# Без секрета POST /tg открыт и кто угодно подделает апдейт от чужого tgId.
BOT_WEBHOOK_SECRET=
# Пусто → алерты операторам просто не отправляются.
ADMIN_BOT_TOKEN=
ADMIN_CHAT_ID=
# Суммы пополнения баланса в рублях (кнопки в боте); внутри везде копейки.
BOT_TOPUP_AMOUNTS=500,1000,2500,5000
BOT_HAPP_INSTALL_URL=https://happ.su/

# --- core <-> bot ---
BOT_INTERNAL_URL=http://localhost:3300   # читает core: куда слать уведомления и рассылки
CORE_API_URL=http://localhost:3100       # читает бот: база core API
# ОБЯЗАТЕЛЬНО. Общий секрет core<->бот, заголовок x-service-token.
# FAIL-CLOSED: пустое значение НЕ отключает проверку — /internal/* и /bot/* отвечают 401 на всё.
# Задаётся одинаковым в обоих процессах.
SERVICE_TOKEN=change-me-service-token

# --- админка ---
# Переходный общий секрет админского API, заголовок x-admin-token (админка хранит значение
# в localStorage). Основной способ входа — учётка оператора: форма email+пароль или Telegram,
# токен сессии идёт в том же заголовке и проверяется ПЕРЕД этой переменной.
# Нужен ровно для одного: завести первого superadmin'а — учётки создаются только изнутри
# админки. Гвард считает эту переменную superadmin'ом, то есть пока она задана, роли
# обходятся одной строкой из .env. УБРАТЬ сразу после того, как именная учётка заведена
# и в неё зашли (security.md, п. 8).
# FAIL-CLOSED: пустое значение проверку не отключает — при пустом токене и без живой сессии
# /api/admin/* отвечает 401 на всё.
ADMIN_TOKEN=change-me-admin-token

# Вход в админку по Telegram настраивается НЕ здесь: username и токен бота лежат в БД
# (таблица telegram_auth_setting, токен зашифрован SECRETS_MASTER_KEY) и правятся на экране
# «Доступ». Домен админки надо один раз привязать к боту через /setdomain в BotFather.

# --- платежи ---
# Ключи мерчантов НЕ здесь: они хранятся в БД (таблица payment_merchant) зашифрованными
# и настраиваются через админку без рестарта. Провайдеры: stars, cryptobot, oxapay,
# paritypay, pal24. Базовые URL провайдеров — константы кода, не настройка.
PAYMENT_SUCCESS_URL=
PAYMENT_FAIL_URL=

# --- мониторинг: детектор по трафику клиентов (джоба traffic-detect) ---
# Нода оценивается, только если у неё в это время обычно (медиана за неделю) не меньше
# стольких активных клиентов: на единицах «трафик пропал» неотличимо от «клиент лёг спать».
TRAFFIC_DETECT_MIN_USERS=10
# Падение активных клиентов против обычного, %, после которого нода считается «пропавшей»
# (два 5-минутных слота подряд). 0 — детектор выключен.
TRAFFIC_DETECT_DROP_PCT=70

# --- миграция с действующей панели (только чтение) ---
# Заполнять только на время переноса. Импорт: POST /api/admin/import/remnawave
# без тела — dry-run; с {"apply":true} — запись.
REMNAWAVE_URL=
REMNAWAVE_TOKEN=

# --- боевое развёртывание (docker-compose.prod.yml) ---
# Отдельный домен админки: админский API не должен висеть на домене подписки —
# случайно открытый путь там означал бы дамп базы подписчиков.
ADMIN_PUBLIC_HOST=
# Пароль БД в боевом compose
POSTGRES_PASSWORD=
